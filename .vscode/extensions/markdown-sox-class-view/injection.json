{
  "scopeName": "markdown.class-view.injection",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "begin": "^\\s*~~~class-view:([^\\s]+)\\s*$",
      "end": "^\\s*~~~\\s*$",
      "name": "meta.embedded.block.class-view",
      "contentName": "source.markdown.class-view",
      "patterns": [
        {
          "include": "text.html.markdown"
        }
      ]
    }
  ]
}
